# Copy this file to .env and fill in your own key. Never commit .env.
OPENROUTER_API_KEY=
# Any OpenAI-compatible service works. Google AI Studio: https://generativelanguage.googleapis.com/v1beta/openai/
AI_BASE_URL=https://openrouter.ai/api/v1
# The model name the service expects (for Google AI Studio, a Gemini model such as gemini-3.8-flash)
AI_MODEL=openai/gpt-oss-120b
